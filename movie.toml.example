[movie.actor]
log-level = "INFO"
startup-timeout = 10
shutdown-timeout = 10
stash-capacity = 10000
callback-workers = 4
max-actors = 100000

[movie.actor.dead-letters]
capacity = 1000
max-subscriptions = 1000

[movie.dispatcher.default-dispatcher]
type = "movie.dispatch.worker_pool.WorkerPoolDispatcherImpl"
workers = 8
shutdown-timeout = 10
queue-capacity = 100000
system-queue-capacity = 100000

[movie.mailbox.default]
type = "movie.mailbox.default.DefaultMailbox"
capacity = 100000
throughput = 100

[movie.io.asyncio]
startup-timeout = 10
command-capacity = 1024
event-loop-count = 1

[movie.persistence]
startup-timeout = 10
operation-timeout = 5
recovery-timeout = 5
operation-capacity = 1024
pending-byte-capacity = 67108864
max-state-bytes = 4194304

[movie.persistence.sqlite]
path = "data/movie.sqlite3"

[movie.projection]
runner-capacity = 32
batch-size = 100
batch-byte-capacity = 16777216
pending-byte-capacity = 67108864
poll-interval = 0.1
retry-min-backoff = 0.1
retry-max-backoff = 5
handler-timeout = 30
scan-limit = 10000
compaction-batch-size = 1000

[movie.io.tcp]
operation-limit = 1024
write-message-limit = 1024
write-byte-limit = 4194304
write-batch-message-limit = 64
write-batch-byte-limit = 262144
write-batch-delay-ms = 1
read-chunk-bytes = 65536
backlog = 128
connect-timeout = 10

[movie.http.server]
max-request-line-bytes = 8192
max-header-bytes = 32768
max-header-count = 100
max-body-bytes = 1048576
max-buffer-bytes = 2097152
max-pipelined-requests = 32
response-buffer = 16
