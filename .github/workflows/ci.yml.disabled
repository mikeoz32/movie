name: CI

on:
  push:
    branches: [master]
    tags: ["v*"]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
        with:
          enable-cache: true
          python-version: "3.14t"
          version: "0.12.2"
      - name: Install dependencies
        run: uv sync --frozen --group test
      - name: Verify free-threaded runtime
        run: uv run python -c "import sys; assert not sys._is_gil_enabled(), sys.version"
      - name: Lint
        run: uv run ruff check .
      - name: Test
        run: uv run pytest --cov=movie --cov-report=term-missing
      - name: Benchmark smoke test
        run: >-
          uv run python -m benchmarks.runtime
          --messages 5000 --actors 100 --warmups 0 --iterations 1
      - name: Scaling smoke test
        run: >-
          uv run python -m benchmarks.scaling
          --messages 5000 --actors 4 --workers 1,4 --cpu-rounds 10
          --warmups 0 --iterations 1 --skip-raw

  package:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
        with:
          enable-cache: true
          python-version: "3.14t"
          version: "0.12.2"
      - name: Verify tag matches package version
        if: startsWith(github.ref, 'refs/tags/v')
        shell: bash
        run: |
          tag_version="${GITHUB_REF_NAME#v}"
          package_version="$(uv run python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
          test "$tag_version" = "$package_version"
      - run: uv build
      - uses: actions/upload-artifact@v4
        with:
          name: distributions
          path: dist/

  publish:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: package
    runs-on: ubuntu-latest
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: distributions
          path: dist/
      - uses: pypa/gh-action-pypi-publish@release/v1
