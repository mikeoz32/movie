FROM ghcr.io/astral-sh/uv:0.12.9-trixie-slim@sha256:768cf5f42923d697ec15b5f765658af82d00b7d107715afc62ede3e5f60de5a9

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN uv python install 3.14t

COPY pyproject.toml uv.lock README.md movie.toml.example ./
COPY movie ./movie
COPY benchmarks ./benchmarks

RUN uv sync --frozen --python 3.14t

ENV PATH="/app/.venv/bin:$PATH"

RUN python -c "import sys; assert not sys._is_gil_enabled()"

CMD ["python", "-m", "benchmarks.http_server", "--host", "0.0.0.0", "--port", "8080"]
